{
  "name": "aida-academy-mini-crm",
  "version": "1.0.19",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "test:a11y": "node --test tests/accessibility.test.mjs",
    "test:security": "node --test tests/security.test.mjs",
    "test:db": "node --test tests/database.test.mjs",
    "test:e2e": "node --test tests/browser-e2e.test.mjs",
    "test:all": "npm run lint && npm run test && npm run build",
    "lint": "eslint app db lib tests --ignore-pattern .next --ignore-pattern dist --ignore-pattern build --ignore-pattern worker --ignore-pattern examples"
  },
  "dependencies": {
    "next": "16.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
